# Copia este archivo como .env y ajusta los valores.
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DB_NAME=edutrack_pagos
DB_USER=edutrack_user
DB_PASSWORD=cambia-esta-clave
DB_HOST=127.0.0.1
DB_PORT=5432
GRAFANA_ADMIN_PASSWORD=cambia-esta-contrasena

# Respaldos automáticos (opcionales)
BACKUP_KEEP=14
BACKUP_HOUR_UTC=7
BACKUP_ON_START=1

# Seguridad (opcionales)
# DJANGO_HTTPS=True activa cookies seguras, redireccion a HTTPS y HSTS (requiere HTTPS delante de nginx)
DJANGO_HTTPS=False
DJANGO_HSTS_SECONDS=0
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Copia externa de respaldos (opcional)
# BACKUP_OFFSITE_PATH=D:/respaldos-externos  (carpeta del host montada en /offsite)
# BACKUP_OFFSITE_DIR=/offsite
# BACKUP_RCLONE_REMOTE=remoto:edutrack  (mas variables RCLONE_CONFIG_*)
# BACKUP_REMOTE_DAYS=30
